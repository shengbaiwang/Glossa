# Copy to .env.glossa.local. Public authentication configuration only.
# Leave blank until a Glossa-owned identity-only project exists.
NEXT_PUBLIC_GLOSSA_AUTH_URL=
NEXT_PUBLIC_GLOSSA_AUTH_KEY=
# Optional web callback; native defaults to glossa://auth-callback (Glossa Dev: glossa-dev).
NEXT_PUBLIC_GLOSSA_AUTH_REDIRECT_URL=
# Show only OAuth providers enabled on your auth project: apple,google,azure
NEXT_PUBLIC_GLOSSA_AUTH_PROVIDERS=
# Enable after deploying the identity-only deletion function.
NEXT_PUBLIC_GLOSSA_AUTH_DELETE_FUNCTION=

# Separate OAuth app registrations for personal storage, not Glossa login.
NEXT_PUBLIC_GLOSSA_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GLOSSA_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_GLOSSA_MICROSOFT_CLIENT_ID=
# iOS only: provisioned Glossa container; macOS uses a chosen iCloud Drive folder.
NEXT_PUBLIC_GLOSSA_ICLOUD_CONTAINER=
# Never put service-role keys, Google secrets or Microsoft secrets in this file.
