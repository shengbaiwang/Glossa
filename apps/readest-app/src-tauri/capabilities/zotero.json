{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "zotero-read-only",
  "description": "Open a selected personal-library Zotero item from the local app.",
  "windows": ["main", "reader-*"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "zotero://select/library/items/*" }]
    }
  ]
}
