{
  "name": "@glossa/sync-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migration:generate": "drizzle-kit generate",
    "migration:new": "drizzle-kit generate --custom",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.0",
    "jose": "^6.2.0",
    "zod": "4.4.3",
    "@glossa/sync-contracts": "workspace:*",
    "aws4fetch": "1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260518.1",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5",
    "wrangler": "4.90.0"
  }
}
